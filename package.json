{
  "name": "event-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "FORCE_COLOR=true next dev --turbopack",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars --outdir dist --upload-source-maps --var SENTRY_RELEASE:$(sentry-cli releases propose-version)",
    "deploy:demo": "opennextjs-cloudflare deploy --env demo --keep-vars",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:deploy": "opennextjs-cloudflare deploy -- --keep-vars --outdir dist --upload-source-maps --var SENTRY_RELEASE:$(sentry-cli releases propose-version) && pnpm run sentry:sourcemaps",
    "start": "next start",
    "lint": "eslint app components core features types tests",
    "lint:fix": "eslint app components core features types tests --fix",
    "lint:cycle": "LINT_NO_CYCLE=1 eslint app components core features types tests",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run --project unit-node --project unit-jsdom --project architecture",
    "test:db:prepare": "tsx tests/setup/prepare-local-supabase.ts",
    "test:server": "pnpm run test:db:prepare && vitest run --project db --project integration",
    "check:all": "pnpm run lint && pnpm run typecheck",
    "prepare": "husky",
    "db:reset": "pnpm exec supabase db reset",
    "db:migrate": "pnpm exec supabase migration up",
    "db:seed": "pnpm exec supabase seed reset",
    "db:types": "pnpm exec supabase gen types typescript --local > types/database.ts.gen && pnpm exec prettier --parser typescript --write types/database.ts.gen && mv types/database.ts.gen types/database.ts",
    "db:dump": "pnpm exec supabase db dump --local -f local_schema.sql",
    "db:generate": "pnpm run db:types && pnpm run db:dump",
    "stripe:listen": "stripe listen --forward-to http://localhost:3000/api/webhooks/stripe --forward-connect-to http://localhost:3000/api/webhooks/stripe-connect",
    "stripe:listen:prod": "stripe listen --forward-to https://minnano-shukin.com/api/webhooks/stripe --forward-connect-to https://minnano-shukin.com/api/webhooks/stripe-connect",
    "sentry:sourcemaps": "_SENTRY_RELEASE=$(sentry-cli releases propose-version) && sentry-cli releases new $_SENTRY_RELEASE --org=tkhs --project=event-pay && sentry-cli sourcemaps upload --org=tkhs --project=event-pay --release=$_SENTRY_RELEASE --strip-prefix 'dist/..' dist",
    "postdeploy": "pnpm run sentry:sourcemaps"
  },
  "dependencies": {
    "@11ty/gray-matter": "^2.1.0",
    "@faker-js/faker": "^10.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@next/third-parties": "^15.5.26",
    "@opennextjs/cloudflare": "^1.20.7",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/cloudflare": "^10.75.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.575.0",
    "next": "^15.5.26",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.89.0",
    "recharts": "^2.15.4",
    "resend": "^6.30.0",
    "sanitize-html": "^2.17.7",
    "schema-dts": "^1.1.5",
    "sonner": "^2.0.8",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^15.5.26",
    "@sentry/cli": "^2.58.6",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.9",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "^0.0.1",
    "shadcn": "^3.8.5",
    "supabase": "2.116.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
